# PortWiz production environment.
#   cp .env.prod.example .env.prod   # then edit every "change-me" below
# Never commit the real .env.prod (it is gitignored).

# --- PostgreSQL / TimescaleDB ---
# Use a strong, unique password. It must match PORTWIZ_DATABASE_URL below.
POSTGRES_USER=portwiz
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=portwiz

# --- PortWiz API ---
# Session signing key. Generate: openssl rand -hex 32
PORTWIZ_SECRET_KEY=change-me-generate-a-long-random-string
# Encrypts stored secrets (API keys, tokens, SMTP password) at rest. Strongly
# recommended in production. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe and stable: rotating or losing it makes existing secrets unreadable.
PORTWIZ_ENCRYPTION_KEY=change-me-generate-a-fernet-key

# Must match POSTGRES_USER/PASSWORD/DB above (host is the compose service "db").
PORTWIZ_DATABASE_URL=postgresql+asyncpg://portwiz:change-me-strong-db-password@db:5432/portwiz
PORTWIZ_CELERY_BROKER_URL=redis://valkey:6379/0
PORTWIZ_CELERY_RESULT_BACKEND=redis://valkey:6379/1

PORTWIZ_ENVIRONMENT=production
PORTWIZ_DEBUG=false
# The prod stack puts nginx in front of the API, so trust its X-Forwarded-For for
# the real agent IP. Set to false if you expose the API without a trusted proxy.
PORTWIZ_TRUST_FORWARDED_FOR=true
# Single-origin: nginx serves the app and proxies /api, so no cross-origin
# requests hit the API. Leave empty unless you call the API from another origin.
PORTWIZ_CORS_ORIGINS=[]

# First admin user, seeded on first boot when the users table is empty.
PORTWIZ_FIRST_ADMIN_EMAIL=admin@example.com
PORTWIZ_FIRST_ADMIN_PASSWORD=change-me-strong-admin-password

# --- AI layer: none | ollama | claude ---
# "none" disables AI. To run a local model, start the compose "ai" profile and
# set this to "ollama"; for Claude set "claude" and provide the API key.
PORTWIZ_AI_PROVIDER=none
# PORTWIZ_ANTHROPIC_API_KEY=
# PORTWIZ_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Notifications (email via SMTP) ---
# Point at your real mail server. No emails are sent unless recipients are set.
PORTWIZ_NOTIFICATIONS_ENABLED=true
PORTWIZ_SMTP_HOST=smtp.example.com
PORTWIZ_SMTP_PORT=587
PORTWIZ_SMTP_FROM=portwiz@example.com
PORTWIZ_SMTP_USERNAME=
PORTWIZ_SMTP_PASSWORD=
PORTWIZ_SMTP_USE_TLS=true
PORTWIZ_NOTIFICATION_RECIPIENTS=["security@example.com"]

# --- Jira integration (disabled by default) ---
# PORTWIZ_JIRA_ENABLED=true
# PORTWIZ_JIRA_URL=https://yourorg.atlassian.net
# PORTWIZ_JIRA_EMAIL=you@yourorg.com
# PORTWIZ_JIRA_API_TOKEN=
# PORTWIZ_JIRA_PROJECT_KEY=PORT

# --- Web ---
# Host port the public nginx listens on. Put your TLS terminator in front of it.
WEB_PORT=8080
