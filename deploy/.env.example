# Copy to .env and adjust. Never commit the real .env (it is gitignored).

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=portwiz
POSTGRES_PASSWORD=portwiz
POSTGRES_DB=portwiz

# --- PortWiz API ---
# Generate a long random value, e.g. `openssl rand -hex 32`.
PORTWIZ_SECRET_KEY=change-me-generate-a-long-random-string
# Encrypts stored secrets (API keys, tokens, SMTP password) at rest. Separate
# from SECRET_KEY. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, secrets are stored in plaintext (a startup warning is logged).
# Keep it safe and stable: rotating or losing it makes existing secrets unreadable.
# PORTWIZ_ENCRYPTION_KEY=
PORTWIZ_DATABASE_URL=postgresql+asyncpg://portwiz:portwiz@db:5432/portwiz
PORTWIZ_CELERY_BROKER_URL=redis://valkey:6379/0
PORTWIZ_CELERY_RESULT_BACKEND=redis://valkey:6379/1
PORTWIZ_CORS_ORIGINS=["http://localhost:5173"]
PORTWIZ_ENVIRONMENT=development
PORTWIZ_DEBUG=true

# First admin user, seeded on first boot when the users table is empty.
PORTWIZ_FIRST_ADMIN_EMAIL=admin@portwiz.local
PORTWIZ_FIRST_ADMIN_PASSWORD=ChangeMe123!

# --- AI layer (provider-agnostic): ollama | claude | none ---
PORTWIZ_AI_PROVIDER=ollama
PORTWIZ_OLLAMA_BASE_URL=http://ollama:11434
# ~2GB, capable enough for the assistant + fingerprint enrichment. After the
# stack is up:  docker exec portwiz-ollama-1 ollama pull qwen2.5:3b
PORTWIZ_OLLAMA_MODEL=qwen2.5:3b
# PORTWIZ_ANTHROPIC_API_KEY=
# PORTWIZ_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Notifications (email via SMTP) ---
# In dev these land in MailHog (http://localhost:8025). No emails are sent
# unless recipients are configured (JSON array).
PORTWIZ_SMTP_HOST=mailhog
PORTWIZ_SMTP_PORT=1025
PORTWIZ_SMTP_FROM=portwiz@portwiz.local
PORTWIZ_NOTIFICATION_RECIPIENTS=["security@portwiz.local"]

# --- Jira integration (disabled by default) ---
# PORTWIZ_JIRA_ENABLED=true
# PORTWIZ_JIRA_URL=https://yourorg.atlassian.net
# PORTWIZ_JIRA_EMAIL=you@yourorg.com
# PORTWIZ_JIRA_API_TOKEN=
# PORTWIZ_JIRA_PROJECT_KEY=PORT

# --- Dev only ---
# Enable uvicorn autoreload inside the api container.
UVICORN_RELOAD=1

# --- Web (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
